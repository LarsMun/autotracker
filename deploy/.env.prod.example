APP_NAME=Auto
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://auto.munne.me
APP_TIMEZONE=Europe/Amsterdam
APP_LOCALE=nl

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=auto
DB_USERNAME=auto
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
# Above the worker's --timeout, or a long run is started a second time.
DB_QUEUE_RETRY_AFTER=3300


# Uptime Kuma push monitor URL (optional), e.g. https://kuma.example/api/push/AbCdEf
MONITOR_PUSH_URL=
